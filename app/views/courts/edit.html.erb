<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-8">
    <%= link_to court_path(@court), class: "inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back to Schedule
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="bg-gray-50 px-6 py-6 border-b border-gray-200">
      <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Edit Court: <%= @court.name %></h1>
    </div>
    
    <div class="px-6 py-8">
      <%= form_with model: @court, class: "space-y-6" do |f| %>
        <% if @court.errors.any? %>
          <div class="rounded-md bg-red-50 p-4 mb-6">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800"><%= pluralize(@court.errors.count, "error") %> prohibited this court from being saved:</h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @court.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.text_field :name, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md border p-2" %>
          </div>
        </div>

        <div>
          <%= f.label :status, "Court Status", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.select :status, 
                [['Open (พร้อมให้บริการ)', 'open'], ['Under Maintenance (ปิดปรับปรุง)', 'maintenance']], 
                {}, 
                class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md border",
                id: "court_status_select",
                onchange: "toggleMaintenanceDate()" 
            %>
          </div>
        </div>

        <!-- Maintenance Date -->
        <div id="maintenance_date_container" style="<%= @court.status == 'maintenance' ? 'display: block;' : 'display: none;' %>" class="mt-6">
          <%= f.label :maintenance_date, "Maintenance Date (วันที่ปิดปรับปรุง)", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1">
            <%= f.date_field :maintenance_date, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border", min: Date.today %>
          </div>
          <p class="mt-2 text-sm text-red-500">Note: All existing bookings on this date will be forcefully cancelled and refunded in full.</p>
        </div>

        <div class="pt-5 border-t border-gray-200 flex justify-end mt-8">
          <%= link_to 'Cancel', court_path(@court), class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-3" %>
          <%= f.submit "Save Changes", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function toggleMaintenanceDate() {
    var status = document.getElementById("court_status_select").value;
    var container = document.getElementById("maintenance_date_container");
    if (status === "maintenance") {
      container.style.display = "block";
    } else {
      container.style.display = "none";
    }
  }
</script>
