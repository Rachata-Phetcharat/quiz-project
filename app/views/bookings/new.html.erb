<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-8">
    <%= link_to court_path(@court.id || 1), class: "inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back to Schedule
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="bg-indigo-600 px-6 py-8 sm:p-10 text-center">
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Confirm Your Booking</h1>
      <p class="mt-2 text-lg text-indigo-100">Please review the details of your reservation.</p>
    </div>
    
    <div class="px-6 py-8 sm:p-10">
      <div class="bg-gray-50 rounded-xl p-6 mb-8 border border-gray-100">
        <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Court</dt>
            <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @court.name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Date</dt>
            <dd class="mt-1 text-base text-gray-900"><%= @booking_date %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Time</dt>
            <dd class="mt-1 text-base text-gray-900"><%= @start_time %> - <%= @end_time %></dd>
          </div>
          <div class="sm:col-span-2 pt-4 border-t border-gray-200 flex justify-between items-center">
            <div>
              <dt class="text-sm font-medium text-gray-500">Price</dt>
              <dd class="mt-1 text-xl font-bold text-gray-900">฿500.00</dd>
            </div>
            <div class="text-right">
              <dt class="text-sm font-medium text-gray-500">Your Balance</dt>
              <dd class="mt-1 text-lg font-semibold <%= @current_user.balance >= 500 ? 'text-green-600' : 'text-red-600' %>">
                ฿<%= number_with_precision(@current_user.balance, precision: 2) %>
              </dd>
            </div>
          </div>
        </dl>
      </div>

      <%= form_with url: bookings_path, method: :post, class: "space-y-6" do |f| %>
        <%= f.hidden_field :court_id, value: @court.id, name: "booking[court_id]" %>
        <%= f.hidden_field :booking_date, value: @booking_date, name: "booking[booking_date]" %>
        <%= f.hidden_field :start_time, value: @start_time, name: "booking[start_time]" %>
        <%= f.hidden_field :end_time, value: @end_time, name: "booking[end_time]" %>
        
        <div>
          <label for="phonenumber" class="block text-sm font-medium text-gray-700">Phone Number <span class="text-red-500">*</span></label>
          <div class="mt-1">
            <input type="tel" name="booking[phonenumber]" id="phonenumber" required pattern="\d{10}" maxlength="10" title="Please enter exactly 10 digits" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md border p-2" placeholder="0812345678">
          </div>
        </div>

        <div class="pt-4">
          <% if @current_user.balance >= 500 %>
            <%= f.submit "Confirm Booking", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" %>
          <% else %>
            <button type="button" disabled class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-gray-400 cursor-not-allowed">
              เงินในบัญชีไม่เพียงพอกรุณาเติมเงิน
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
